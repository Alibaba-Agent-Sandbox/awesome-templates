# Explicit portable profile: source bytes are not rewritten by providers.
FROM python:3.12.12-slim-bookworm@sha256:593bd06efe90efa80dc4eee3948be7c0fde4134606dd40d8dd8dbcade98e669c

ENV LANG=C.UTF-8
RUN groupadd --gid 1000 user && useradd --uid 1000 --gid 1000 --create-home user \
    && pip install --no-cache-dir --index-url https://pypi.org/simple "agent-sandbox-server==0.4.0a6" "pytest==8.4.2"
WORKDIR /home/user/app
COPY --chown=user:user commands.py .
USER user
EXPOSE 9000
