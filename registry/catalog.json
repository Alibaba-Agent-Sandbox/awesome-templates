{
  "providers": [
    {
      "id": "alicloud-express",
      "name": "阿里云极速版",
      "cli": true,
      "sdk": true,
      "default": true,
      "templates": "templates.read 和 templates.build 都可用。abx template install 会构建并注册。",
      "limits": "CLI 只加载这一个 provider。"
    },
    {
      "id": "alicloud-container",
      "name": "阿里云容器版",
      "cli": false,
      "sdk": true,
      "default": false,
      "templates": "不能构建模板（E8004）。只能使用集群里已经存在的 template id。",
      "limits": "没有 pause、文件监听、文件 URL、模板、VPC。命名命令返回 E8004。abx --provider 返回 E8001。"
    },
    {
      "id": "cubesandbox",
      "name": "CubeSandbox",
      "cli": false,
      "sdk": true,
      "default": false,
      "templates": "不能构建模板（E8004）。创建时的 template id 必须已经在 CubeAPI 上。",
      "limits": "没有 pty、进程管理、文件监听。claude-code 和 qoder 声明了 terminal，在这里不能开终端。"
    },
    {
      "id": "e2b",
      "name": "E2B",
      "cli": false,
      "sdk": true,
      "default": false,
      "templates": "不读取本仓库的 Dockerfile。使用账号里已有的 template id，公开的有 base、code-interpreter-v1、desktop。",
      "limits": "不读 ABX_SANDBOX_API_KEY，也不读旧名 E2B_API_KEY。密钥是 ABX_E2B_API_KEY。模板构建是 E8004。"
    },
    {
      "id": "opensandbox",
      "name": "OpenSandbox",
      "cli": false,
      "sdk": true,
      "default": false,
      "templates": "没有公共模板仓库。创建参数是镜像 URI。base 会被改写成 python:3.12-slim。",
      "limits": "入口命令被引擎改成 tail -f /dev/null，或 code-interpreter 脚本。Dockerfile 的 CMD 不会执行。code.interpret 和 sandbox.run 是 E8004。"
    }
  ],
