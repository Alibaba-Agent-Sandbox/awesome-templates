    "_skeleton": {
      "smoke": [
        {
          "command": "hello",
          "args": {
            "name": "Express"
          },
          "expect": "Hello, Express!"
        }
      ],
      "priority": "P2",
      "wave": "other",
      "services": {
        "app": {
          "protocol": "agent-sandbox-server",
          "version": 2,
          "port": 9000,
          "operations": [
            "commands.list",
            "commands.run"
          ]
        }
      },
      "ports": [],
      "runtime": {
        "start": "agent-sandbox-server serve --port 9000 --commands /home/user/app/commands.py",
        "ready": "agent-sandbox-server healthcheck --port 9000",
        "envNames": [
          "ABX_SERVER_TOKEN"
        ]
      }
    },
