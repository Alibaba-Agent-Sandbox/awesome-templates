      "compile": false
    },
    {
      "id": "steps",
      "manifest": {
        "specVersion": 1,
        "name": "example",
        "sandbox": {
          "agent": {
            "provider": "alicloud-express",
            "template": {
              "image": "registry.example/image:1",
              "region": "cn-hangzhou",
              "buildConfig": {
                "steps": [
                  {
                    "type": "RUN",
                    "args": [
                      "echo ok"
                    ]
                  },
                  {
                    "type": "ENV",
                    "args": [
                      "A",
                      "B",
                      "C",
                      "D"
                    ]
                  }
                ]
              }
            }
          }
        }
      },
      "stage": "intent",
      "compile": false
    },
    {
