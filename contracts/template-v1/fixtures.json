{
  "validTemplates": [
    {
      "id": "existing-image",
      "manifest": {
        "specVersion": 1,
        "name": "example",
        "sandbox": {
          "agent": {
            "provider": "alicloud-express",
            "template": {
              "image": "registry.example/image:1",
              "region": "cn-hangzhou"
            }
          }
        }
      },
      "stage": "resolved",
      "compile": true
    },
    {
      "id": "dockerfile-directory",
      "manifest": {
        "specVersion": 1,
        "name": "example",
        "sandbox": {
          "agent": {
            "provider": "alicloud-express",
            "template": {
              "image": "registry.example/image:1",
              "region": "cn-hangzhou",
              "buildConfig": {
                "dockerfile": "./sandbox/Dockerfile"
              }
            }
          }
        }
      },
      "stage": "intent",
      "compile": false
    },
