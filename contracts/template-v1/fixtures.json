            }
          }
        },
        "serving": {
          "api": {
            "component": "serverless-devs/fc3@0.1.26",
            "props": {
              "region": "cn-hangzhou",
              "environmentVariables": {
                "TEMPLATE_ID": "${resources.agent.output.templateId}"
              }
            }
          }
        }
      },
      "stage": "intent",
      "compile": false
    },
    {
      "id": "volume",
